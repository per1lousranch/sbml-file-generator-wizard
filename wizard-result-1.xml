    <listOfParameters>
      <parameter id="p3tr" name="gp130-dependent receptor complex formation" value="1" constant="true"/>
      <parameter id="p4tr" name="IL-6/sIL-6Ralpha-dependent receptor complex dissociation" value="0.1" constant="true"/>
      <parameter id="p5" name="SOCS3 inhibitory effect on receptor activation" value="1" constant="true"/>
      <parameter id="p6" name="active receptor complex deactivation" value="0.1" constant="true"/>
      <parameter id="p7" name="STAT3 phosphorylation" value="1" constant="true"/>
      <parameter id="p8" name="pSTAT3 dephosphorylation" value="0.5" constant="true"/>
      <parameter id="p9" name="SOCS3 mRNA transcription induced by pSTAT3" value="1" constant="true"/>
      <parameter id="pdelay1" name="SOCS3 mRNA processing delay" value="0.5" constant="true"/>
      <parameter id="p10" name="SOCS3 mRNA degradation" value="0.1" constant="true"/>
      <parameter id="p11" name="SOCS3 translation step marked as blocked in the diagram" value="0" constant="true"/>
      <parameter id="pdelay2" name="SOCS3 protein maturation delay" value="0.5" constant="true"/>
      <parameter id="p12" name="SOCS3 degradation" value="0.1" constant="true"/>
      <parameter id="p13" name="long SOCS3 negative feedback on receptor signalling" value="1" constant="true"/>
    </listOfParameters>
    <listOfReactions>
      <reaction id="R1_receptor_complex_formation" name="IL-6, sIL-6Ralpha, and gp130 form Rcomplex" reversible="false" fast="false">
        <listOfReactants>
          <speciesReference species="IL6" stoichiometry="1" constant="true"/>
          <speciesReference species="sIL6Ra" stoichiometry="1" constant="true"/>
          <speciesReference species="gp130" stoichiometry="1" constant="true"/>
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="Rcomplex" stoichiometry="1" constant="true"/>
        </listOfProducts>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
              <times/>
              <ci> p3tr </ci>
              <ci> IL6 </ci>
              <ci> sIL6Ra </ci>
              <ci> gp130 </ci>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
      <reaction id="R2_receptor_complex_dissociation" name="Rcomplex dissociation" reversible="false" fast="false">
        <listOfReactants>
          <speciesReference species="Rcomplex" stoichiometry="1" constant="true"/>
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="IL6" stoichiometry="1" constant="true"/>
          <speciesReference species="sIL6Ra" stoichiometry="1" constant="true"/>
          <speciesReference species="gp130" stoichiometry="1" constant="true"/>
        </listOfProducts>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
              <times/>
              <ci> p4tr </ci>
              <ci> Rcomplex </ci>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
      <reaction id="R3_receptor_activation" name="Rcomplex activation inhibited by SOCS3 feedback" reversible="false" fast="false">
        <listOfReactants>
          <speciesReference species="Rcomplex" stoichiometry="1" constant="true"/>
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="actRcomplex" stoichiometry="1" constant="true"/>
        </listOfProducts>
        <listOfModifiers>
          <modifierSpeciesReference species="SOCS3"/>
        </listOfModifiers>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
              <divide/>
              <ci> Rcomplex </ci>
              <apply>
                <plus/>
                <cn type="integer"> 1 </cn>
                <apply>
                  <times/>
                  <ci> p5 </ci>
                  <ci> SOCS3 </ci>
                </apply>
                <apply>
                  <times/>
                  <ci> p13 </ci>
                  <ci> SOCS3 </ci>
                </apply>
              </apply>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
      <reaction id="R4_active_receptor_deactivation" name="actRcomplex deactivation to Rcomplex" reversible="false" fast="false">
        <listOfReactants>
          <speciesReference species="actRcomplex" stoichiometry="1" constant="true"/>
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="Rcomplex" stoichiometry="1" constant="true"/>
        </listOfProducts>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
              <times/>
              <ci> p6 </ci>
              <ci> actRcomplex </ci>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
      <reaction id="R5_STAT3_phosphorylation" name="actRcomplex phosphorylates STAT3" reversible="false" fast="false">
        <listOfReactants>
          <speciesReference species="STAT3" stoichiometry="1" constant="true"/>
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="pSTAT3" stoichiometry="1" constant="true"/>
        </listOfProducts>
        <listOfModifiers>
          <modifierSpeciesReference species="actRcomplex"/>
        </listOfModifiers>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
              <times/>
              <ci> p7 </ci>
              <ci> actRcomplex </ci>
              <ci> STAT3 </ci>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
      <reaction id="R6_STAT3_dephosphorylation" name="pSTAT3 dephosphorylation" reversible="false" fast="false">
        <listOfReactants>
          <speciesReference species="pSTAT3" stoichiometry="1" constant="true"/>
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="STAT3" stoichiometry="1" constant="true"/>
        </listOfProducts>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
              <times/>
              <ci> p8 </ci>
              <ci> pSTAT3 </ci>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
      <reaction id="R7_SOCS3_mRNA_transcription" name="pSTAT3 induces SOCS3 mRNA_1" reversible="false" fast="false">
        <listOfProducts>
          <speciesReference species="SOCS3_mRNA_1" stoichiometry="1" constant="true"/>
        </listOfProducts>
        <listOfModifiers>
