              <ci> SOCS3_mRNA </ci>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
      <reaction id="R12_SOCS3_delay_1" name="SOCS3_1 to SOCS3_2" reversible="false" fast="false">
        <listOfReactants>
          <speciesReference species="SOCS3_1" stoichiometry="1" constant="true"/>
        </listOfReactants>
