            </apply>
          </math>
        </kineticLaw>
      </reaction>
      <reaction id="R13_SOCS3_delay_2" name="SOCS3_2 to mature SOCS3" reversible="false" fast="false">
        <listOfReactants>
          <speciesReference species="SOCS3_2" stoichiometry="1" constant="true"/>
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="SOCS3" stoichiometry="1" constant="true"/>
        </listOfProducts>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
              <times/>
              <ci> pdelay2 </ci>
              <ci> SOCS3_2 </ci>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
      <reaction id="R14_SOCS3_degradation" name="SOCS3 degradation" reversible="false" fast="false">
        <listOfReactants>
          <speciesReference species="SOCS3" stoichiometry="1" constant="true"/>
        </listOfReactants>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
