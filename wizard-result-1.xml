            <apply>
              <times/>
              <ci> p9 </ci>
              <ci> pSTAT3 </ci>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
      <reaction id="R8_mRNA_delay_1" name="SOCS3 mRNA_1 to SOCS3 mRNA_2" reversible="false" fast="false">
        <listOfReactants>
          <speciesReference species="SOCS3_mRNA_1" stoichiometry="1" constant="true"/>
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="SOCS3_mRNA_2" stoichiometry="1" constant="true"/>
        </listOfProducts>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
              <times/>
              <ci> pdelay1 </ci>
              <ci> SOCS3_mRNA_1 </ci>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
      <reaction id="R9_mRNA_delay_2" name="SOCS3 mRNA_2 to mature SOCS3 mRNA" reversible="false" fast="false">
        <listOfReactants>
          <speciesReference species="SOCS3_mRNA_2" stoichiometry="1" constant="true"/>
        </listOfReactants>
