      <multi:speciesType multi:id="ST_SOCS3" multi:name="SOCS3 protein">
        <multi:listOfSpeciesFeatureTypes>
          <multi:speciesFeatureType multi:id="socs3_maturation_stage" multi:name="SOCS3 maturation stage" multi:occur="1">
            <multi:listOfPossibleSpeciesFeatureValues>
